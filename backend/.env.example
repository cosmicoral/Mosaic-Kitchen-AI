OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# development | production. Controls secure/sameSite cookie flags and trust proxy.
NODE_ENV=development

# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173

# lax (default) or none. Leave unset unless the frontend sits on a different
# registrable domain from the API — subdomains of one domain are same-site and
# work fine on lax, which is the safer setting.
# COOKIE_SAMESITE=lax

PORT=3000

# Overrides the default model. Must exist in MODEL_PRICING in services/openai.ts.
OPENAI_MODEL=gpt-5.6-luna

# Public origin of the browser app. Used for OAuth landings and Stripe's
# success/cancel/return URLs.
APP_URL=http://localhost:5173

# Public origin of this API. Used to build the OAuth redirect_uri, which must
# match what is registered with the provider byte for byte — anything else
# fails as redirect_uri_mismatch.
API_ORIGIN=http://localhost:3000

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Register these redirect URIs on that client:
#   http://localhost:3000/api/auth/google/callback
#   https://api.<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard. The two are different values; using the wrong one fails every
# webhook with a signature error.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids, not product ids. An id missing here resolves that plan to the
# free tier rather than granting it, so a typo under-serves rather than
# over-serves.
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...