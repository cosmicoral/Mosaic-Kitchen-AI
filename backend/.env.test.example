# Copy to .env.test and point DATABASE_URL at a DEDICATED test database.
# The suite TRUNCATEs users and sessions before every test — pointing this at
# your development branch will wipe it.
#
# Neon makes this cheap: Branches -> New Branch -> name it "test", branched
# from production. The free plan allows 10 branches. Copy that branch's
# connection string here, then run `npm run migrate:up` once against it
# (DATABASE_URL=<test branch url> npm run migrate:up) to create the tables.

NODE_ENV=test
DATABASE_URL=postgresql://user:password@test-branch-host/neondb?sslmode=require

# Not used by the auth tests, but app.ts reads it at import time.
OPENAI_API_KEY=not-needed-for-tests
CORS_ORIGINS=http://localhost:5173
