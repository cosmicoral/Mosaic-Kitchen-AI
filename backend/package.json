{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.test --test-concurrency=1 --test \"tests/**/*.test.ts\"",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "cleanup:sessions": "node scripts/cleanup-sessions.ts",
    "migrate:up:test": "node-pg-migrate up --envPath .env.test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "multer": "^2.1.1",
    "node-pg-migrate": "^9.0.0",
    "openai": "^6.39.1",
    "openid-client": "^6.8.7",
    "pg": "^8.22.0",
    "stripe": "^22.6.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
