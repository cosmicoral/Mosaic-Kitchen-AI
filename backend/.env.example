OPENAI_API_KEY=your-openai-api-key-here

# verify-full, not require.
#
# The driver currently treats 'require' as 'verify-full' anyway, so this is a
# no-op today — which is exactly why it is worth writing out. In pg v9 and
# pg-connection-string v3 those modes revert to libpq semantics, where 'require'
# means encrypt but do *not* validate the certificate. A routine dependency
# upgrade would then silently downgrade every database connection to something
# a man-in-the-middle can read, with no error and no warning, because the
# connection still succeeds. Naming the mode we actually want pins it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# development | production. Controls secure/sameSite cookie flags and trust proxy.
NODE_ENV=development

# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173

# lax (default) or none. Leave unset unless the frontend sits on a different
# registrable domain from the API — subdomains of one domain are same-site and
# work fine on lax, which is the safer setting.
# COOKIE_SAMESITE=lax

PORT=3000

# Overrides the default model. Must exist in MODEL_PRICING in services/openai.ts.
OPENAI_MODEL=gpt-5.6-luna

# Public origin of the browser app. Used for OAuth landings and Stripe's
# success/cancel/return URLs.
APP_URL=http://localhost:5173

# Public origin of this API. Used to build the OAuth redirect_uri, which must
# match what is registered with the provider byte for byte — anything else
# fails as redirect_uri_mismatch.
API_ORIGIN=http://localhost:3000

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Register these redirect URIs on that client:
#   http://localhost:3000/api/auth/google/callback
#   https://api.<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard. The two are different values; using the wrong one fails every
# webhook with a signature error.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids, not product ids. An id missing here resolves that plan to the
# free tier rather than granting it, so a typo under-serves rather than
# over-serves.
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Optional. The Customer Portal configuration to use (bpc_...).
#
# Only needed when the Stripe account serves more than one product. Portal
# configurations are account-level and hold a single pair of terms and privacy
# links, so a shared Default configuration would show one product's privacy
# notice to another product's customers. Unset, the account Default is used and
# behaviour is unchanged.
STRIPE_PORTAL_CONFIGURATION_ID=

# Object storage for profile pictures. Leave these unset in development and
# uploads land in backend/.uploads/, served from /uploads — no Cloudflare
# account needed to run the app.
#
# R2 rather than S3 because egress is free, and avatars are read far more often
# than they are written. Storage itself is negligible either way: a 256px WebP
# is about 30 KB, so ten thousand of them is 0.3 GB, comfortably inside R2's
# 10 GB free tier.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# A custom domain in front of the bucket. The r2.dev hostname is rate limited,
# documented as unsuitable for production, and puts the account id in every
# avatar URL.
R2_PUBLIC_URL=

# Retrieval over the curated knowledge base. Off unless set to exactly 'true'.
# The corpus is empty; see docs/rag.md.
RETRIEVAL_ENABLED=false
# Which grocery catalogue region to check availability against.
GROCERY_REGION=uk

# --- Production-only, but listed so they are not discovered by their absence ---

# Leave this unset in production too, for app.<domain> and api.<domain>.
#
# The comment that used to be here said the opposite — that 'none' is required
# across subdomains because a browser treats them as different sites. That is
# wrong, and wrong in the expensive direction: SameSite is judged on the
# registrable domain, not the origin. app.example.com and api.example.com are
# cross-*origin* but same-*site*, so 'lax' works and keeps the CSRF protection
# that 'none' throws away.
#
# Set it to 'none' only for a frontend on a genuinely different registrable
# domain — a default *.vercel.app URL, say — and prefer fixing that with a
# custom subdomain.
COOKIE_SAMESITE=

# Global ceiling on AI spend attributable to free accounts, per calendar month.
# Only free accounts are ever refused by it; paying subscribers are not. Warns
# in the logs at 80%. Defaults to 100 if unset.
FREE_TIER_MONTHLY_SPEND_CAP_GBP=100

# Per-account monthly AI spend, in pounds. The ceiling above bounds everyone
# together; these bound one account, which is a different failure — a single
# runaway loop can exhaust a whole-product budget while every individual quota
# still looks untouched.
#
#   TARGET    a reporting line. No behaviour change.
#   SOFT_CAP  degrade: shorter do-not-repeat list, one generation attempt
#             instead of two, card-scope translation instead of full. The
#             allergen and cuisine checks are untouched — degrading is a
#             quality decision, never a safety one.
#   HARD_CAP  refuse. Reaching this means a loop or an abusive account, not a
#             keen cook: it is three times what the free quotas can legitimately
#             cost.
#
# None of these numbers are ever shown to a user. A cost ceiling is our problem,
# and "you have used £0.05 of AI" tells a stranger about our margins while
# telling them nothing they can act on. Unset or non-positive values fall back
# to the defaults in src/config/aiBudget.ts.
FREE_AI_COST_TARGET_GBP=0.025
FREE_AI_COST_SOFT_CAP_GBP=0.03
FREE_AI_COST_HARD_CAP_GBP=0.05

# The same three for paying accounts, set an order of magnitude higher. A Plus
# subscriber costs about £0.14 of AI against £7.99 of revenue, so this is a
# runaway detector rather than a ration — a paying customer who reaches it
# should get a conversation, not a wall.
PAID_AI_COST_TARGET_GBP=1.0
PAID_AI_COST_SOFT_CAP_GBP=2.0
PAID_AI_COST_HARD_CAP_GBP=5.0

# Optional. A cheaper model for the ingredient classifier, which is a much
# smaller job than meal planning. Falls back to OPENAI_MODEL.
OPENAI_CLASSIFIER_MODEL=

